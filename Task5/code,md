##4. Pseudocode

START
rates = USD:85, EUR:95, GBP:110
INPUT budget, number_of_expenses
expenses = empty list
total = 0
FOR each expense
    INPUT category, currency, amount
    IF currency exists in rates
        converted = amount * rates[currency]
        ADD (category, converted) TO expenses
        total = total + converted
    ELSE
        DISPLAY "Invalid currency"
    END IF
END FOR
IF expenses is not empty
    FIND expense with maximum converted amount
    IF total > budget
        DISPLAY "Budget Exceeded"
    ELSE
        DISPLAY "Within Budget"
    END IF
    DISPLAY total and largest category
ELSE
    DISPLAY "No valid expenses"
END IF
STOP

##5. Sample Input

Enter travel budget in INR: 30000
Enter number of expenses: 3
Hotel, USD, 100
Food, EUR, 50
Shopping, GBP, 100

